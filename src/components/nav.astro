---
interface NavItem { label: string; href: string; }
const navItems: NavItem[] = [
  { label: "Home", href: "/#home" },
  { label: "Projects", href: "/#projects" },
  { label: "Writeups", href: "/writeups" },
  { label: "Contact", href: "/#contact" },
];
---
<div class="flex justify-center w-full">
  <nav id="main-nav" class="fixed left-1/2 -translate-x-1/2 z-[100] bg-[var(--background)] border border-transparent backdrop-blur-xl transition-all duration-500 ease-in-out md:top-6 md:bottom-auto bottom-0 w-[92%] max-w-4xl">
    <div class="container mx-auto flex justify-center items-center p-3">
      <ul class="flex w-full justify-center gap-3 md:gap-10">
        {navItems.map((item) => (
          <li class="flex-1 md:flex-none">
            <a href={item.href} class="flex justify-center items-center text-[var(--white-icon)] hover:text-white transition-colors text-xs md:text-sm px-3 py-2 rounded-full" data-nav-link={item.href}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</div>
<style>
  nav.scrolling { background-color: var(--component-bg); border-color: #ffffff10; border-radius: 9999px; }
  nav a.active { color: white !important; background: #ffffff0b; }
  @media (max-width: 767px) {
    nav { width: 100% !important; bottom: 0; border-radius: 1rem 1rem 0 0; border-color: #ffffff10; }
    nav.scrolling { border-radius: 1rem 1rem 0 0; }
    body { padding-bottom: 70px; }
  }
</style>
<script>
  const nav = document.getElementById("main-nav");
  window.addEventListener("scroll", () => nav?.classList.toggle("scrolling", window.scrollY > 0), { passive: true });
  const path = window.location.pathname;
  document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]").forEach((link) => {
    const href = link.getAttribute("href") || "";
    if ((path === "/" && href === "/#home") || href.startsWith(path) && path !== "/") link.classList.add("active");
  });
</script>
