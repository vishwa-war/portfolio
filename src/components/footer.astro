---
const currentYear = new Date().getFullYear();
---
<footer class="w-full py-10 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
    <p class="text-sm text-[var(--white-icon)]">© {currentYear} Vishwa Erroju</p>
    <div class="flex items-center gap-5 text-sm">
      <a href="/" class="text-[var(--white-icon)] hover:text-white">Home</a>
      <a href="/writeups" class="text-[var(--white-icon)] hover:text-white">Writeups</a>
      <a href="https://github.com/vishwa-war" target="_blank" rel="noreferrer" class="text-[var(--white-icon)] hover:text-white">GitHub ↗</a>
    </div>
  </div>
</footer>
